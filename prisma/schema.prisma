  id          String          @id @default(cuid())
  batchId     String          @map("batch_id")
  sourceUrl   String?         @map("source_url")
  sourceLabel String?         @map("source_label")
  finalUrl    String?         @map("final_url")
  rawText     String?         @map("raw_text")
  rawHtml     String?         @map("raw_html")
  diagnostics Json?
  createdAt   DateTime        @default(now()) @map("created_at")
  batch       DataImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model DataImportRecord {
  id                    String                 @id @default(cuid())
  batchId               String                 @map("batch_id")
  sourceType            DataSourceType         @map("source_type")
  target                DataImportTarget
  status                ImportRecordStatus     @default(PENDING_REVIEW)
  recordType            String                 @map("record_type")
  payloadJson           Json                   @map("payload_json")
  rawText               String?                @map("raw_text")
  sourceSnippet         String?                @map("source_snippet")
  sourceUrl             String?                @map("source_url")
  sourceLabel           String?                @map("source_label")
  rankingYear           Int?                   @map("ranking_year")
  physicianName         String?                @map("physician_name")
  roleTitle             String?                @map("role_title")
  hospitalNameRaw       String?                @map("hospital_name_raw")
  specialtyRaw          String?                @map("specialty_raw")
  normalizedHospitalId  String?                @map("normalized_hospital_id")
  normalizedSpecialtyId String?                @map("normalized_specialty_id")
  normalizedDepartmentId String?               @map("normalized_department_id")
  confidenceScore       Float?                 @map("confidence_score")
  dedupeKey             String?                @unique @map("dedupe_key")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  batch                 DataImportBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  normalizedDepartment  Department?            @relation(fields: [normalizedDepartmentId], references: [id], onDelete: SetNull)
  externalPeople        DepartmentExternalPerson[]

  @@index([batchId, status])
  @@index([normalizedDepartmentId])
  @@index([sourceType, target])
  @@index([rankingYear])
}

model ReviewSubmission {
  id                     String            @id @default(cuid())
  departmentId           String            @map("department_id")
  reviewerType           ReviewSourceType  @map("reviewer_type")
  fullName               String?           @map("full_name")
  phone                  String
  email                  String?
  isAnonymous            Boolean           @default(true) @map("is_anonymous")
  teachingQuality        Int               @map("teaching_quality")
  workAtmosphere         Int               @map("work_atmosphere")
  seniorsApproachability Int               @map("seniors_approachability")
  researchExposure       Int               @map("research_exposure")
  lifestyleBalance       Int               @map("lifestyle_balance")
  overallRecommendation  Int               @map("overall_recommendation")
  pros                   String
  cons                   String
  tips                   String
  roleDetails            Json?             @map("role_details")
  consentToContact       Boolean           @map("consent_to_contact")
  consentToTerms         Boolean           @map("consent_to_terms")
  consentNoPatientInfo   Boolean           @map("consent_no_patient_info")
  verificationStatus     VerificationStatus @default(PENDING_PROOF) @map("verification_status")
  verificationToken      String?           @unique @map("verification_token")
  tokenExpiry            DateTime?         @map("token_expiry")
  proofUploadedAt        DateTime?         @map("proof_uploaded_at")
  verifiedByAdminId      String?           @map("verified_by_admin_id")
  verifiedAt             DateTime?         @map("verified_at")
  status                 SubmissionStatus  @default(PENDING_REVIEW)
  adminNote              String?           @map("admin_note")
  reviewedByUserId       String?           @map("reviewed_by_user_id")
  reviewedAt             DateTime?         @map("reviewed_at")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  department             Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reviewedBy             User?             @relation("ReviewSubmissionModerator", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  verifiedByAdmin        User?             @relation("ReviewSubmissionVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  publishedReview        Review?
  verificationFiles      UploadedFile[]    @relation("ReviewSubmissionFiles")

  @@index([departmentId, status])
  @@index([reviewerType, status])
  @@index([verificationStatus])
}

model Review {
  id                     String           @id @default(cuid())
  departmentId           String           @map("department_id")
  submissionId           String           @unique @map("submission_id")
  reviewerType           ReviewSourceType @map("reviewer_type")
  displayName            String?          @map("display_name")
  isAnonymous            Boolean          @default(true) @map("is_anonymous")
  teachingQuality        Int              @map("teaching_quality")
  workAtmosphere         Int              @map("work_atmosphere")
  seniorsApproachability Int              @map("seniors_approachability")
  researchExposure       Int              @map("research_exposure")
  lifestyleBalance       Int              @map("lifestyle_balance")
  overallRecommendation  Int              @map("overall_recommendation")
  pros                   String
  cons                   String
  tips                   String
  verificationStatus     VerificationStatus @default(VERIFIED) @map("verification_status")
  publishedAt            DateTime         @default(now()) @map("published_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  department             Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  submission             ReviewSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reports                ReviewReport[]

  @@index([departmentId, publishedAt])
}

model ReviewReport {
  id             String    @id @default(cuid())
  reviewId       String    @map("review_id")
  reporterUserId String?   @map("reporter_user_id")
  reason         String
  details        String?
  createdAt      DateTime  @default(now()) @map("created_at")
  review         Review    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter       User?     @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([reviewId])
}

model PublisherRequest {
  id               String                 @id @default(cuid())
  userId           String                 @map("user_id")
  departmentId     String?                @map("department_id")
  institutionId    String?                @map("institution_id")
  requestedRole    RoleKey                @default(REPRESENTATIVE) @map("requested_role")
  note             String?
  status           PublisherRequestStatus @default(PENDING)
  adminNote        String?                @map("admin_note")
  reviewedByUserId String?                @map("reviewed_by_user_id")
  reviewedAt       DateTime?              @map("reviewed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  user             User                   @relation("PublisherRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?                  @relation("PublisherRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  institution      Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([departmentId, status])
}

model UploadedFile {
  id                   String               @id @default(cuid())
  departmentId         String?              @map("department_id")
  openingId            String?              @map("opening_id")
  openingApplicationId String?              @map("opening_application_id")
  reviewSubmissionId   String?              @map("review_submission_id")
  uploadedByUserId     String?              @map("uploaded_by_user_id")
  category             UploadedFileCategory
  isPublic             Boolean              @default(false) @map("is_public")
  originalName         String               @map("original_name")
  mimeType             String               @map("mime_type")
  sizeBytes            Int                  @map("size_bytes")
  bytes                Bytes
  createdAt            DateTime             @default(now()) @map("created_at")
  department           Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  opening              ResidencyOpening?    @relation("OpeningFiles", fields: [openingId], references: [id], onDelete: SetNull)
  application          OpeningApplication?  @relation("ApplicationFiles", fields: [openingApplicationId], references: [id], onDelete: SetNull)
  reviewSubmission     ReviewSubmission?    @relation("ReviewSubmissionFiles", fields: [reviewSubmissionId], references: [id], onDelete: SetNull)
  uploadedBy           User?                @relation("UploadedFileOwner", fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([departmentId])
  @@index([openingId, category])
  @@index([openingApplicationId, category])
  @@index([reviewSubmissionId, category])
}

model FavoriteDepartment {
  userId       String     @map("user_id")
  departmentId String     @map("department_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
}

model AuditLog {
  id          String    @id @default(cuid())
  actorUserId String?   @map("actor_user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}
