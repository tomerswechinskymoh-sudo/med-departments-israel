generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleKey {
  STUDENT
  RESIDENT
  REPRESENTATIVE
  ADMIN
}

enum InstitutionType {
  HOSPITAL
  HMO
}

enum ReviewSourceType {
  RESIDENT
  INTERN
  STUDENT
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum OpportunityStatus {
  OPEN
  UPCOMING
  CLOSED
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PublisherRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OpeningType {
  RESIDENCY
  FELLOWSHIP
  ACADEMIC_TRACK
  COMMUNITY_TRACK
  OTHER
}

enum OpeningApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  CONTACTED
  ARCHIVED
}

enum ElectiveAvailabilityMode {
  OPEN_BY_DEFAULT
  CLOSED_BY_DEFAULT
}

enum ElectiveWindowStatus {
  OPEN
  CLOSED
}

enum ElectiveApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  APPROVED
  WAITLISTED
  REJECTED
  ALTERNATIVE_OFFERED
  ALTERNATIVE_ACCEPTED
  ALTERNATIVE_DECLINED
  CANCELLED
  ARCHIVED
}

enum ElectiveRepresentativeAssignmentRole {
  PRIMARY
  SECONDARY
  VIEW_ONLY
}

enum FellowshipExperienceVisibility {
  ADMIN_ONLY
  PUBLIC_ANONYMIZED
  PUBLIC_IDENTIFIED
}

enum UploadedFileCategory {
  OPENING_ATTACHMENT
  APPLICATION_CV
  APPLICATION_PROFILE_PHOTO
  APPLICATION_SUPPORTING
  REVIEW_VERIFICATION_PROOF
  REPRESENTATIVE_REQUEST_PROOF
  USER_VERIFICATION_PROOF
}

enum DepartmentScrapeRevisionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum DepartmentMistakeReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum DepartmentRepresentativeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DepartmentRepresentativeRequesterRole {
  RESIDENT
  SPECIALIST
  DEPARTMENT_STAFF
}

enum DunsImportBatchStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
}

enum DataImportBatchStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  FAILED
  FAILED_NEEDS_ASSISTED_IMPORT
}

enum ImportRecordStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum DataSourceType {
  DUNS100
  HOSPITAL_WEBSITE
  MINISTRY_REPORT
  MANUAL_PASTE
  OTHER
}

enum DataImportTarget {
  DUNS100_PHYSICIANS
  DEPARTMENT_METRICS
  DEPARTMENT_LEADERSHIP
  RESIDENCY_OPENINGS
  CUSTOM
}

enum DataImportJobStatus {
  RUNNING
  FAILED
  PARTIAL
  COMPLETED
}

enum VerificationStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_PROOF
  PENDING_ADMIN_REVIEW
  VERIFIED
  REJECTED
}

model Role {
  key         RoleKey @id
  label       String
  description String
  users       User[]
}

model User {
  id                          String                  @id @default(cuid())
  email                       String                  @unique
  passwordHash                String                  @map("password_hash")
  fullName                    String                  @map("full_name")
  phone                       String?
  linkedinId                  String?                 @unique @map("linkedin_id")
  googleId                    String?                 @unique @map("google_id")
  facebookId                  String?                 @unique @map("facebook_id")
  profileImageUrl             String?                 @map("profile_image_url")
  linkedinConnectedAt         DateTime?               @map("linkedin_connected_at")
  roleKey                     RoleKey                 @default(STUDENT) @map("role_key")
  isApprovedPublisher         Boolean                 @default(false) @map("is_approved_publisher")
  emailVerified               Boolean                 @default(false) @map("email_verified")
  emailVerifiedAt             DateTime?               @map("email_verified_at")
  emailVerificationToken      String?                 @unique @map("email_verification_token")
  emailVerificationExpiresAt  DateTime?               @map("email_verification_expires_at")
  roleStatus                  String?                 @map("role_status")
  verificationStatus          VerificationStatus      @default(PENDING_EMAIL_VERIFICATION) @map("verification_status")
  verificationProofUrl        String?                 @map("verification_proof_url")
  verificationSubmittedAt     DateTime?               @map("verification_submitted_at")
  verificationRejectionReason String?                 @map("verification_rejection_reason")
  marketingConsent            Boolean                 @default(false) @map("marketing_consent")
  marketingConsentAt          DateTime?               @map("marketing_consent_at")
  verificationToken           String?                 @unique @map("verification_token")
  tokenExpiry                 DateTime?               @map("token_expiry")
  verifiedByAdminId           String?                 @map("verified_by_admin_id")
  verifiedAt                  DateTime?               @map("verified_at")
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")
  role                        Role                    @relation(fields: [roleKey], references: [key], onUpdate: Cascade)
  verifiedByAdmin             User?                   @relation("UserVerifier", fields: [verifiedByAdminId], references: [id], onDelete: SetNull)
  verifiedUsers               User[]                  @relation("UserVerifier")
  favorites                   FavoriteDepartment[]
  representativeProfile       RepresentativeProfile?
  representativeAssignments   RepresentativeAssignment[] @relation("RepresentativeAssignments")
  createdRepresentativeAssignments RepresentativeAssignment[] @relation("RepresentativeAssignmentCreator")
  submittedDepartmentChangeRequests DepartmentChangeRequest[] @relation("DepartmentChangeSubmitter")
  reviewedDepartmentChangeRequests DepartmentChangeRequest[] @relation("DepartmentChangeReviewer")
  createdOfficialUpdates      OfficialDepartmentUpdate[] @relation("OfficialUpdateAuthor")
  createdResidencyOpenings    ResidencyOpening[]      @relation("ResidencyOpeningAuthor")
  reviewedResidencyOpenings   ResidencyOpening[]      @relation("ResidencyOpeningReviewer")
  createdResearchOpportunities ResearchOpportunity[]  @relation("ResearchOpportunityAuthor")
  publisherRequests           PublisherRequest[]      @relation("PublisherRequestOwner")
  reviewedPublisherRequests   PublisherRequest[]      @relation("PublisherRequestReviewer")
  moderatedReviewSubmissions  ReviewSubmission[]      @relation("ReviewSubmissionModerator")
  verifiedReviewSubmissions   ReviewSubmission[]      @relation("ReviewSubmissionVerifier")
  reviewedOpeningApplications OpeningApplication[]    @relation("OpeningApplicationReviewer")
  reviewReports               ReviewReport[]
  uploadedFiles               UploadedFile[]          @relation("UploadedFileOwner")
  auditEntries                AuditLog[]              @relation("AuditActor")
  reviewedDepartmentScrapeRevisions DepartmentScrapeRevision[] @relation("DepartmentScrapeRevisionReviewer")
  reviewedDepartmentRepresentativeRequests DepartmentRepresentativeRequest[] @relation("DepartmentRepresentativeRequestReviewer")
  reviewedDunsImportBatches DunsImportBatch[] @relation("DunsImportBatchReviewer")
  createdDataImportBatches DataImportBatch[] @relation("DataImportBatchCreator")
  reviewedDataImportBatches DataImportBatch[] @relation("DataImportBatchReviewer")
  createdDataImportJobs DataImportJob[] @relation("DataImportJobCreator")
  createdElectiveDepartmentAccounts ElectiveDepartmentAccount[] @relation("ElectiveDepartmentAccountCreator")
  electiveApplications       ElectiveApplication[]    @relation("ElectiveApplicationApplicant")
  createdFellowshipSpecialties FellowshipSpecialty[] @relation("FellowshipSpecialtyCreator")
  createdFellowshipPrograms FellowshipProgram[] @relation("FellowshipProgramCreator")
  createdFellowshipExperiences FellowshipIsraeliExperience[] @relation("FellowshipExperienceCreator")

  @@index([roleKey])
  @@index([isApprovedPublisher])
  @@index([verificationStatus])
  @@index([roleStatus])
}

model Institution {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  type              InstitutionType
  city              String?
  region            String?
  latitude          Float?
  longitude         Float?
  summary           String
  websiteUrl        String?            @map("website_url")
  coverImageUrl     String?            @map("cover_image_url")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  departments       Department[]
  medicalArrays     MedicalArray[]
  publisherRequests PublisherRequest[]
  dunsPhysicianRecords DunsPhysicianRecord[] @relation("DunsPhysicianRecordInstitution")

  @@index([type])
  @@index([city])
  @@index([region])
}

model Specialty {
  id                      String                    @id @default(cuid())
  name                    String
  slug                    String                    @unique
  description             String
  groupAsArray            Boolean                   @default(false) @map("group_as_array")
  dataSourceNotes         String?                   @map("data_source_notes")
  dataLastUpdated         DateTime?                 @map("data_last_updated")
  departments             Department[]
  medicalArrays           MedicalArray[]
  dashboardConfig         SpecialtyDashboardConfig?
  metrics                 SpecialtyMetric[]
  yearlyMetrics           SpecialtyYearlyMetric[]
  dunsPhysicianRecords    DunsPhysicianRecord[] @relation("DunsPhysicianRecordSpecialty")
  fellowshipSpecialties   FellowshipSpecialty[] @relation("FellowshipSpecialtyBaseSpecialty")
  fellowshipPrograms      FellowshipProgram[] @relation("FellowshipProgramBaseSpecialty")
}

model SpecialtyMetric {
  id              String    @id @default(cuid())
  specialtyId     String    @map("specialty_id")
  metricKey       String    @map("metric_key")
  label           String
  value           Float?
  rawValue        String?   @map("raw_value")
  unit            String?
  sourceNotes     String?   @map("source_notes")
  lastUpdated     DateTime? @map("last_updated")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  specialty       Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([specialtyId, metricKey])
  @@index([metricKey])
}

model SpecialtyYearlyMetric {
  id              String    @id @default(cuid())
  specialtyId     String    @map("specialty_id")
  metricKey       String    @map("metric_key")
  year            Int
  value           Float?
  rawValue        String?   @map("raw_value")
  unit            String?
  sourceNotes     String?   @map("source_notes")
  lastUpdated     DateTime? @map("last_updated")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  specialty       Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@unique([specialtyId, metricKey, year])
  @@index([metricKey, year])
}

model SpecialtyDashboardConfig {
  id                 String    @id @default(cuid())
  specialtyId        String    @unique @map("specialty_id")
  enabledMetricsJson Json      @map("enabled_metrics_json")
  displayOrderJson   Json      @map("display_order_json")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  specialty          Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
}

model DataExplanation {
  id                  String   @id @default(cuid())
  sheet               String
  criterion           String
  normalizedCriterion String   @map("normalized_criterion")
  metricKey           String?  @map("metric_key")
  readableLabel       String   @map("readable_label")
  explanation         String?
  sourceLabel         String?  @map("source_label")
  sourceLinkPolicy    String?  @map("source_link_policy")
  sourceUrl           String?  @map("source_url")
  displayAction       String?  @map("display_action")
  displayMode         String?  @map("display_mode")
  visualType          String?  @map("visual_type")
  isHidden            Boolean  @default(false) @map("is_hidden")
  isHighlighted       Boolean  @default(false) @map("is_highlighted")
  isNationalMetric    Boolean  @default(false) @map("is_national_metric")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([sheet, normalizedCriterion])
  @@index([sheet, metricKey])
  @@index([isHidden, isHighlighted])
}

model Department {
  id                      String                   @id @default(cuid())
  institutionId           String                   @map("institution_id")
  specialtyId             String                   @map("specialty_id")
  medicalArrayId          String?                  @map("medical_array_id")
  slug                    String                   @unique
  importStableKey         String?                  @unique @map("import_stable_key")
  name                    String
  shortSummary            String                   @map("short_summary")
  about                   String
  practicalInfo           String                   @map("practical_info")
  publicContactEmail      String?                  @map("public_contact_email")
  publicContactPhone      String?                  @map("public_contact_phone")
  websiteUrl              String?                  @map("website_url")
  applicationUrl          String?                  @map("application_url")
  dataSourceNotes         String?                  @map("data_source_notes")
  dataLastUpdated         DateTime?                @map("data_last_updated")
  contactName             String?                  @map("contact_name")
  residentsCount          Int?                     @map("residents_count")
  medianResidencyLength   String?                  @map("median_residency_length")
  shlavAlephPassRate      Float?                   @map("shlav_aleph_pass_rate")
  shlavBetPassRate        Float?                   @map("shlav_bet_pass_rate")
  newResidentsThisYear    Int?                     @map("new_residents_this_year")
  expectedGraduatesThisYear Int?                   @map("expected_graduates_this_year")
  genderBalance           String?                  @map("gender_balance")
  perks                   String?
  candidatePreferences    String?                  @map("candidate_preferences")
  educationLocationBreakdown Json?                 @map("education_location_breakdown")
  coverImageUrl           String?                  @map("cover_image_url")
  futureEnrichmentEnabled Boolean                  @default(false) @map("future_enrichment_enabled")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  institution             Institution              @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  specialty               Specialty                @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  medicalArray            MedicalArray?            @relation(fields: [medicalArrayId], references: [id], onDelete: SetNull)
  heads                   DepartmentHead[]
  residencyOpenings       ResidencyOpening[]
  researchOpportunities   ResearchOpportunity[]
  officialUpdates         OfficialDepartmentUpdate[]
  reviewSubmissions       ReviewSubmission[]
  reviews                 Review[]
  favorites               FavoriteDepartment[]
  publisherRequests       PublisherRequest[]
  uploadedFiles           UploadedFile[]
  representativeAssignments RepresentativeAssignment[]
  departmentChangeRequests DepartmentChangeRequest[]
  scrapeRevisions        DepartmentScrapeRevision[]
  mistakeReports         DepartmentMistakeReport[]
  representativeRequests DepartmentRepresentativeRequest[]
  externalMetrics        DepartmentExternalMetric[]
  externalPeople         DepartmentExternalPerson[]
  metrics                DepartmentMetric[]
  yearlyMetrics          DepartmentYearlyMetric[]
  researchMetrics        DepartmentResearchMetric[]
  dataImportRecords      DataImportRecord[]
  dataImportRowLogs      DataImportRowLog[]
  dunsPhysicianRecords   DunsPhysicianRecord[] @relation("DunsPhysicianRecordDepartment")
  electiveDepartmentAccount ElectiveDepartmentAccount?
  electiveSettings      ElectiveDepartmentSettings?
  electiveAvailabilityWindows ElectiveAvailabilityWindow[]
  electiveApplications  ElectiveApplication[]
  electiveRepresentativeAssignments ElectiveRepresentativeDepartmentAssignment[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([specialtyId])
  @@index([medicalArrayId])
  @@index([name])
}

model DepartmentMetric {
  id              String     @id @default(cuid())
  departmentId    String     @map("department_id")
  metricKey       String     @map("metric_key")
  label           String
  value           Float?
  rawValue        String?    @map("raw_value")
  unit            String?
  sourceNotes     String?    @map("source_notes")
  lastUpdated     DateTime?  @map("last_updated")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, metricKey])
  @@index([metricKey])
}

model DepartmentYearlyMetric {
  id              String     @id @default(cuid())
  departmentId    String     @map("department_id")
  metricKey       String     @map("metric_key")
  year            Int
  value           Float?
  rawValue        String?    @map("raw_value")
  unit            String?
  sourceNotes     String?    @map("source_notes")
  lastUpdated     DateTime?  @map("last_updated")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, metricKey, year])
  @@index([metricKey, year])
}

model DepartmentResearchMetric {
  id                String     @id @default(cuid())
  departmentId      String     @map("department_id")
  year              Int
  publicationsCount Int?       @map("publications_count")
  source            String     @default("OpenAlex")
  queryUsed         String?    @map("query_used")
  confidenceScore   Float?     @map("confidence_score")
  needsMapping      Boolean    @default(false) @map("needs_mapping")
  isAmbiguous       Boolean    @default(false) @map("is_ambiguous")
  rawResponseJson   Json?      @map("raw_response_json")
  warningsJson      Json?      @map("warnings_json")
  lastUpdated       DateTime   @default(now()) @updatedAt @map("last_updated")
  createdAt         DateTime   @default(now()) @map("created_at")
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, year, source])
  @@index([needsMapping, confidenceScore])
  @@index([year, source])
}

model OpenAlexAliasMapping {
  id           String   @id @default(cuid())
  entityType   String   @map("entity_type")
  hebrewName   String   @map("hebrew_name")
  aliasesJson  Json     @map("aliases_json")
  keywordsJson Json?    @map("keywords_json")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([entityType, hebrewName])
  @@index([entityType])
}

model MedicalArray {
  id                         String                     @id @default(cuid())
  hospitalId                 String                     @map("hospital_id")
  specialtyId                String                     @map("specialty_id")
  name                       String
  slug                       String                     @unique
  description                String?
  recruitedResidentsByYear   Json?                      @map("recruited_residents_by_year")
  totalPublicationsCount     Int?                       @map("total_publications_count")
  residentPublicationsCount  Int?                       @map("resident_publications_count")
  publicationYears           Json?                      @map("publication_years")
  publicationSourceUrl       String?                    @map("publication_source_url")
  specialistsCount           Int?                       @map("specialists_count")
  createdAt                  DateTime                   @default(now()) @map("created_at")
  updatedAt                  DateTime                   @updatedAt @map("updated_at")
  hospital                   Institution                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  specialty                  Specialty                  @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  departments                Department[]
  externalMetrics            DepartmentExternalMetric[]
  externalPeople             DepartmentExternalPerson[]

  @@unique([hospitalId, specialtyId])
  @@index([specialtyId])
}

model SalaryAssumption {
  id                      String   @id @default(cuid())
  key                     String   @unique
  label                   String
  centerMonthlySalary     Float    @map("center_monthly_salary")
  peripheryMonthlySalary  Float    @map("periphery_monthly_salary")
  seniorityIncrement      Float    @default(0) @map("seniority_increment")
  assumptionsJson         Json?    @map("assumptions_json")
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
}

model RepresentativeProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  title          String?  @map("title")
  contactDetails String?  @map("contact_details")
  note           String?  @map("note")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepresentativeAssignment {
  id              String     @id @default(cuid())
  userId          String     @map("user_id")
  departmentId    String     @map("department_id")
  createdByUserId String?    @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  user            User       @relation("RepresentativeAssignments", fields: [userId], references: [id], onDelete: Cascade)
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation("RepresentativeAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model DepartmentHead {
  id              String      @id @default(cuid())
  departmentId    String      @map("department_id")
  name            String
  title           String
  role            String?
  bio             String
  profileImageUrl String?     @map("profile_image_url")
  displayOrder    Int         @default(0) @map("display_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  department      Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, displayOrder])
}

model ResidencyOpening {
  id                 String                 @id @default(cuid())
  departmentId       String                 @map("department_id")
  createdByUserId    String?                @map("created_by_user_id")
  reviewedByUserId   String?                @map("reviewed_by_user_id")
  supersedesOpeningId String?               @map("supersedes_opening_id")
  title              String
  summary            String
  openingType        OpeningType            @map("opening_type")
  isImmediate        Boolean                @default(false) @map("is_immediate")
  openingsCount      Int?                   @map("openings_count")
  topApplicantsToEmail Int                  @default(5) @map("top_applicants_to_email")
  status             OpportunityStatus
  committeeDate      DateTime?              @map("committee_date")
  applicationDeadline DateTime?             @map("application_deadline")
  expectedStartDate  DateTime?              @map("expected_start_date")
  notes              String?
  supportingInfo     String?                @map("supporting_info")
  topMatchesDeliveredAt DateTime?           @map("top_matches_delivered_at")
  topMatchesLastError String?               @map("top_matches_last_error")
  reviewNote         String?                @map("review_note")
  reviewedAt         DateTime?              @map("reviewed_at")
  contentStatus      ContentStatus          @default(PUBLISHED) @map("content_status")
  publishedAt        DateTime?              @map("published_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdBy          User?                  @relation("ResidencyOpeningAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy         User?                  @relation("ResidencyOpeningReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  supersedesOpening  ResidencyOpening?      @relation("OpeningRevision", fields: [supersedesOpeningId], references: [id], onDelete: SetNull)
  pendingRevisions   ResidencyOpening[]     @relation("OpeningRevision")
  acceptanceCriteria OpeningAcceptanceCriteria?
  applications       OpeningApplication[]
  attachments        UploadedFile[]         @relation("OpeningFiles")

  @@index([departmentId, contentStatus])
  @@index([status, contentStatus])
  @@index([committeeDate])
  @@index([applicationDeadline])
  @@index([topMatchesDeliveredAt])
  @@index([supersedesOpeningId])
}

model OpeningAcceptanceCriteria {
  id                                   String            @id @default(cuid())
  openingId                            String            @unique @map("opening_id")
  researchImportance                   Int               @default(3) @map("research_importance")
  departmentElectiveImportance         Int               @default(3) @map("department_elective_importance")
  departmentInternshipImportance       Int               @default(3) @map("department_internship_importance")
  residentSelectionInfluence           Int               @default(3) @map("resident_selection_influence")
  specialistSelectionInfluence         Int               @default(3) @map("specialist_selection_influence")
  departmentHeadInfluence              Int               @default(3) @map("department_head_influence")
  medicalSchoolInfluence               Int               @default(3) @map("medical_school_influence")
  recommendationsImportance            Int               @default(3) @map("recommendations_importance")
  personalFitImportance                Int               @default(3) @map("personal_fit_importance")
  previousDepartmentExperienceImportance Int             @default(3) @map("previous_department_experience_importance")
  notes                                String?
  whatWeAreLookingFor                  String?           @map("what_we_are_looking_for")
  createdAt                            DateTime          @default(now()) @map("created_at")
  updatedAt                            DateTime          @updatedAt @map("updated_at")
  opening                              ResidencyOpening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
}

model OpeningApplication {
  id                        String                   @id @default(cuid())
  openingId                 String                   @map("opening_id")
  reviewedByUserId          String?                  @map("reviewed_by_user_id")
  applicantType             ReviewSourceType         @map("applicant_type")
  fullName                  String                   @map("full_name")
  phone                     String
  email                     String?
  medicalSchool             String?                  @map("medical_school")
  didDepartmentElective     Boolean                  @default(false) @map("did_department_elective")
  departmentElectiveDetails String?                  @map("department_elective_details")
  hasResearch               Boolean                  @default(false) @map("has_research")
  researchDetails           String?                  @map("research_details")
